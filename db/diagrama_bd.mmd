erDiagram
    lote_carga ||--o{ dato_entrenamiento : "contiene"
    modelo ||--o{ prediccion : "genera"

    lote_carga {
        SERIAL id PK
        VARCHAR nombre_archivo
        INTEGER filas_recibidas
        INTEGER filas_validas
        INTEGER duplicados_eliminados
        INTEGER filas_invalidas
        TIMESTAMP fecha
    }
    dato_entrenamiento {
        SERIAL id PK
        INTEGER lote_id FK
        INTEGER paginas_administrativas
        NUMERIC tiempo_administrativas
        INTEGER paginas_informativas
        NUMERIC tiempo_informativas
        INTEGER paginas_producto
        NUMERIC tiempo_producto
        NUMERIC tasa_rebote
        NUMERIC tasa_salida
        NUMERIC valor_pagina
        NUMERIC dia_especial
        VARCHAR mes
        SMALLINT sistema_operativo
        SMALLINT navegador
        SMALLINT region
        SMALLINT tipo_trafico
        VARCHAR tipo_visitante
        BOOLEAN fin_de_semana
        BOOLEAN compra "objetivo"
        TIMESTAMP fecha
    }
    modelo {
        SERIAL id PK
        INTEGER version UK
        VARCHAR algoritmo
        JSONB hiperparametros
        NUMERIC umbral
        NUMERIC recall
        NUMERIC precision
        NUMERIC f1
        NUMERIC f2
        NUMERIC roc_auc
        JSONB matriz_confusion
        INTEGER filas_entrenamiento
        INTEGER filas_prueba
        VARCHAR ruta_archivo
        BOOLEAN activo
        TIMESTAMP fecha
    }
    prediccion {
        SERIAL id PK
        INTEGER modelo_id FK
        JSONB entrada
        BOOLEAN resultado
        NUMERIC probabilidad
        TIMESTAMP fecha
    }
    usuario {
        SERIAL id PK
        VARCHAR usuario UK
        VARCHAR password_hash
        VARCHAR rol
        BOOLEAN activo
        TIMESTAMP fecha
    }
