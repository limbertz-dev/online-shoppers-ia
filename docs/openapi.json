              "Feb",
              "Mar",
              "Apr",
              "May",
              "June",
              "Jul",
              "Aug",
              "Sep",
              "Oct",
              "Nov",
              "Dec"
            ],
            "title": "Month",
            "description": "Mes de la sesión"
          },
          "OperatingSystems": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Operatingsystems",
            "description": "Código del sistema operativo"
          },
          "Browser": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Browser",
            "description": "Código del navegador"
          },
          "Region": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Region",
            "description": "Código de la región"
          },
          "TrafficType": {
