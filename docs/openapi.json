{
  "openapi": "3.1.0",
  "info": {
    "title": "Online Shoppers IA",
    "description": "Servicio de IA que predice si una sesión de navegación en una tienda online termina en **compra**.\n\nModelo de clasificación supervisada entrenado con el dataset *Online Shoppers Purchasing Intention* siguiendo la metodología CRISP-ML(Q). Los datos de entrenamiento, los modelos con sus métricas y el historial de predicciones se guardan en PostgreSQL.\n\nFlujo: `POST /training-data` (subir CSV) → `POST /retrain` (entrenar) → `POST /predict` (predecir) → `GET /predictions` y `GET /metrics` (consultar).\n\n**Seguridad:** todos los endpoints (salvo `/health` y `/auth/login`) exigen un JWT en el encabezado `Authorization: Bearer <token>`. El token se obtiene en `POST /auth/login`. Rol `admin`: todo; rol `analista`: predecir y consultar. En Swagger use el botón **Authorize**.",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión y obtener un JWT",
        "description": "Recibe usuario y contraseña (formulario) y devuelve un JSON Web Token con vencimiento.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_auth_login_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Usuario del token actual",
        "operationId": "yo_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioActual"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Predicción"
        ],
        "summary": "Enviar datos al modelo y obtener la predicción",
        "description": "Recibe las 17 variables de una sesión, devuelve si habrá compra y la guarda en el historial.",
        "operationId": "predecir_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SesionEntrada"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrediccionRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/predictions": {
      "get": {
        "tags": [
          "Predicción"
        ],
        "summary": "Historial de predicciones previas",
        "description": "Devuelve los datos enviados y el resultado de cada predicción, de la más reciente a la más antigua.",
        "operationId": "historial_predictions_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistorialRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Métricas de rendimiento del modelo activo",
        "description": "Recall, Precision, F1, F2, ROC-AUC y matriz de confusión del modelo activo (conjunto de prueba).",
        "operationId": "metricas_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModeloMetricas"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/metrics/history": {
      "get": {
        "tags": [
          "Modelo"
        ],
        "summary": "Métricas de todas las versiones del modelo",
        "description": "Permite comparar cómo cambiaron las métricas en cada reentrenamiento.",
        "operationId": "metricas_historial_metrics_history_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModeloMetricas"
                  },
                  "type": "array",
                  "title": "Response Metricas Historial Metrics History Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/retrain": {
      "post": {
        "tags": [
          "Modelo"
        ],
        "summary": "Reentrenar el modelo con la información actualizada (rol admin)",
        "description": "Entrena una nueva versión con todos los datos de la tabla de entrenamiento usando la configuración\nelegida en el notebook (algoritmo, hiperparámetros y criterio de umbral). Guarda sus métricas y la activa\nsolo si cumple Recall >= 70 %.",
        "operationId": "reentrenar_retrain_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReentrenamientoRespuesta"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/training-data": {
      "post": {
        "tags": [
          "Datos"
        ],
        "summary": "Enviar el archivo CSV de entrenamiento (rol admin)",
        "description": "Valida y limpia el CSV (tipos, filas inválidas, nulos, duplicados) y lo guarda en la tabla de\nentrenamiento. Después se puede llamar a POST /retrain.",
        "operationId": "cargar_datos_training_data_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "reemplazar",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "TRUE borra los datos anteriores antes de cargar",
              "default": false,
              "title": "Reemplazar"
            },
            "description": "TRUE borra los datos anteriores antes de cargar"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_cargar_datos_training_data_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CargaRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado del servicio",
        "operationId": "salud_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_cargar_datos_training_data_post": {
        "properties": {
          "archivo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Archivo",
            "description": "CSV con las 18 columnas del dataset"
          }
        },
        "type": "object",
        "required": [
          "archivo"
        ],
        "title": "Body_cargar_datos_training_data_post"
      },
