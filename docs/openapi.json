          "Informational": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Informational",
            "description": "Páginas informativas visitadas"
          },
          "Informational_Duration": {
            "type": "number",
            "minimum": 0.0,
            "title": "Informational Duration",
            "description": "Segundos en páginas informativas"
          },
          "ProductRelated": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Productrelated",
