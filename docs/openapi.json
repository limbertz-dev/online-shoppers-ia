            "description": "Métricas del modelo que estaba activo antes"
          }
        },
        "type": "object",
        "required": [
          "modelo_id",
          "version",
          "algoritmo",
          "activado",
          "motivo",
          "umbral",
          "metricas",
          "matriz_confusion",
          "filas_entrenamiento",
          "filas_prueba",
