          },
          "filas_entrenamiento": {
            "type": "integer",
            "title": "Filas Entrenamiento"
          },
          "filas_prueba": {
            "type": "integer",
            "title": "Filas Prueba"
          },
          "modelo_anterior": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
